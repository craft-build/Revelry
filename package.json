{
  "name": "revelry-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Revelry — AI roleplay desktop application UI (SvelteKit + Svelte 5 + Bits.ui)",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:preview": "tauri build && tauri dev --no-watch",
    "tauri:check": "tauri info"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.59",
    "@sveltejs/vite-plugin-svelte": "^7.1",
    "@tailwindcss/vite": "^4.3",
    "@tauri-apps/cli": "^2.11.1",
    "prettier": "^3.8",
    "prettier-plugin-svelte": "^3.5",
    "prettier-plugin-tailwindcss": "^0.8",
    "svelte": "^5.55",
    "svelte-check": "^4.4",
    "tailwindcss": "^4.3",
    "tslib": "^2.8",
    "typescript": "^6.0",
    "vite": "^8.0"
  },
  "dependencies": {
    "@lucide/svelte": "^1.14",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "@tauri-apps/plugin-http": "^2.5.9",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-store": "^2.4.3",
    "bits-ui": "^2.18",
    "clsx": "^2.1",
    "tailwind-merge": "^3.5",
    "tailwind-variants": "^3.2"
  }
}
