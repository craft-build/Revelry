{
  "name": "revelry-ui",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "description": "Revelry — AI roleplay desktop application UI (SvelteKit + Svelte 5 + Bits.ui)",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "format": "prettier --write .",
    "lint": "prettier --check .",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "win:build": "tauri build --runner cargo-xwin --target x86_64-pc-windows-msvc",
    "tauri:preview": "tauri build && tauri dev --no-watch",
    "tauri:check": "tauri info",
    "wdio": "wdio run ./wdio.conf.ts"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.3",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2.12.3",
    "@types/node": "^26.6.5",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "@wdio/tauri-plugin": "^1.5.0",
    "@wdio/tauri-service": "^1.5.0",
    "expect-webdriverio": "^5.7.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.7",
    "tailwindcss": "^4.3.3",
    "tslib": "^2.8.1",
    "typescript": "^6.0.3",
    "vite": "^8.3.4"
  },
  "dependencies": {
    "@lucide/svelte": "^1.58.0",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.3",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.8.3",
    "@tauri-apps/plugin-shell": "^2.5.0",
    "@tauri-apps/plugin-store": "^2.5.0",
    "bits-ui": "^2.19.5",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "marked": "^18.1.1",
    "shiki": "^4.5.0",
    "tailwind-merge": "^3.7.0",
    "tailwind-variants": "^3.3.1"
  }
}
